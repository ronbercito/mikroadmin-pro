model Router {
  id                      Int         @id @default(autoincrement())
  name                    String
  router_type             String      @default("MikroTik")
  host                    String
  api_port                Int         @default(8728)
  use_tls                 Boolean     @default(false)
  username                String
  password                String
  location                String?
  model                   String?
  ros_version             String?
  security                String      @default("none_accounting_api")
  security_alt            String      @default("none")
  radius_secret           String?
  radius_nas_ip           String?
  traffic_logging         String      @default("traffic_flow")
  traffic_flow_target     String?
  traffic_flow_interface  String?     @default("all")
  speed_control           String      @default("simple_queues")
  save_visited_ips        Boolean     @default(true)
  status                  String      @default("unknown")
  last_sync               DateTime?
  notes                   String?
  created_at              DateTime    @default(now())
  updated_at              DateTime    @updatedAt
  clients                 Client[]
  change_logs             ChangeLog[]
  networks                Network[]   // <-- Relación añadida con Network
}

model Network {
  id         Int      @id @default(autoincrement())
  name       String
  router_id  Int
  router     Router   @relation(fields: [router_id], references: [id], onDelete: Cascade)
  network    String
  cidr       Int      @default(24)
  type       String   @default("ESTÁTICO")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}
